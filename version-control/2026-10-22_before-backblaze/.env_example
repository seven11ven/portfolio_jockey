# =====================================================================
# Portfolio Jockey: environment variables
# ---------------------------------------------------------------------
# HOW TO USE
#   1. Copy this file to a new file named ".env" in the repo root.
#   2. Fill in each value in ".env" only. NEVER put real values here.
#      This file is public. ".env" is ignored by Git.
#   3. On Vercel, add the same variables under:
#      Project > Settings > Environment Variables
# =====================================================================


# ---------------------------------------------------------------------
# DATABASE (Neon Postgres)
# ---------------------------------------------------------------------
# DATABASE_URL: the connection string the app uses to read and write
# projects, notes, and file records.
# Setup: neon.tech > your project > Dashboard > "Connect".
#   Copy the connection string with "Pooled connection" turned on.
#   It starts with postgresql:// and includes a password, so treat
#   the whole string as a secret.
DATABASE_URL=


# ---------------------------------------------------------------------
# AUTHENTICATION (Better Auth + GitHub sign-in)
# ---------------------------------------------------------------------
# BETTER_AUTH_SECRET: a long random string used to sign login sessions.
# Anyone with it could forge a login, so keep it secret.
# Setup: run these two lines. The first moves you to the repo root, so the
# secret lands in the right .env. The second writes a new random secret
# straight into .env without showing it on screen:
#   cd "$(git rev-parse --show-toplevel)"
#   sed -i "s|^BETTER_AUTH_SECRET=.*|BETTER_AUTH_SECRET=$(openssl rand -hex 32)|" .env
# Use a different value for local development and for Vercel.
BETTER_AUTH_SECRET=

# BETTER_AUTH_URL: the address the app runs at, used for login redirects.
# Setup: use the exact address you open the app at, with no trailing slash.
#   Local computer: http://localhost:3000
#   GitHub Codespaces in the browser: the forwarded address for port 3000,
#     such as https://<codespace-name>-3000.app.github.dev
#   Vercel: your deployed address, such as https://<your-app>.vercel.app
BETTER_AUTH_URL=

# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET: let users sign in with GitHub.
# Setup: github.com > Settings > Developer settings > OAuth Apps > New OAuth App.
#   Homepage URL: same as BETTER_AUTH_URL
#   Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
#   Then copy the Client ID, and click "Generate a new client secret".
#   Create one OAuth App for local development and one for production,
#   because each allows only one callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ALLOWED_EMAILS: the only GitHub accounts allowed to sign in.
# Everyone else is rejected, so strangers can't create accounts.
# Setup: a comma-separated list of the primary email on each allowed
#   GitHub account, for example: one@example.com,two@example.com
ALLOWED_EMAILS=


# TRUSTED_ORIGINS: extra addresses allowed to make logged-in requests,
# such as signing out. BETTER_AUTH_URL is always trusted, so most setups
# leave this EMPTY, including Vercel.
# Setup: only for GitHub Codespaces opened in a web browser. Codespaces'
#   proxy rewrites the request's origin to https://localhost:3000, so
#   without this, signing out fails with "Invalid origin". Set it to:
#     https://localhost:3000
#   Comma-separate several entries. Never add an address you don't control.
TRUSTED_ORIGINS=


# ---------------------------------------------------------------------
# FILE STORAGE (Cloudflare R2, private bucket)
# ---------------------------------------------------------------------
# R2_ACCOUNT_ID: your Cloudflare account ID, used to build the R2 address.
# Setup: dash.cloudflare.com > R2 Object Storage > the Account ID shown
#   on the overview page.
R2_ACCOUNT_ID=

# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: credentials the app uses to
# create short-lived upload and download links.
# Setup: R2 > Manage R2 API Tokens > Create API Token.
#   Permission: "Object Read & Write"
#   Scope: "Apply to specific buckets only" and pick your bucket only.
#   Copy both values right away. The secret is shown only once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2_BUCKET: the name of your private bucket. Do NOT enable public access.
# Setup: R2 > Create bucket, then type the bucket name here.
#   Lowercase letters, numbers and hyphens only.
R2_BUCKET=

# R2_ENDPOINT: leave EMPTY to use Cloudflare R2.
# Only set it to point the app at a different S3-compatible server, such
# as a local test server, for example http://127.0.0.1:9000
R2_ENDPOINT=


# ---------------------------------------------------------------------
# LIMITS (keeps usage inside the free tier)
# ---------------------------------------------------------------------
# STORAGE_QUOTA_BYTES: total storage allowed per account. Uploads past
# this are refused. Keep it below R2's 10 GB free tier so you're never billed.
# Setup: optional. Leave empty to use the default of 9 GB (9663676416).
STORAGE_QUOTA_BYTES=
