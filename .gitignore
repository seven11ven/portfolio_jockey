# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# notes
/project-notes

# environmental variables
.env*
!.env_example

# Flutter / Dart build output and tool caches
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
migrate_working_dir/
.widget_preview/
**/doc/api/
# generated by the Flutter tool for the Linux build
/app/linux/flutter/ephemeral/
# generated by pub inside the empty stand-in packages (see app/tool/stubs/)
/app/tool/stubs/*/pubspec.lock
# symbol and obfuscation maps from release builds
app.*.symbols
app.*.map.json

# testing
/coverage
/app/coverage/

# signing keys and local SDK paths: never commit (also covers a future Android port)
*.jks
*.keystore
key.properties
local.properties
*.pem

# IDE
.idea/
*.iml
*.ipr
*.iws

# misc
.DS_Store
*.log
*.swp

# Flatpak packaging (phase 8): the app bundle, build kit and build output
/packaging/flatpak/dist/
/packaging/flatpak/build-dir/
/packaging/flatpak/repo/
.flatpak-builder/
*.flatpak
